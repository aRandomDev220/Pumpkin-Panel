# Non-secret defaults only. Never commit real secrets here.
PUMPKIN_MANAGER_HTTP_PORT=8080
PUMPKIN_MANAGER_LOG_LEVEL=info
PUMPKIN_MANAGER_METRICS_INTERVAL_SECONDS=30
PUMPKIN_MANAGER_SESSION_TTL_MINUTES=720
# Absolute host path used by both the manager and its child containers. The
# path is intentionally identical on both sides of the Compose bind mount.
PUMPKIN_MANAGER_DATA_ROOT=/data
# Non-root numeric uid:gid used by child Pumpkin containers. The bundled
# manager image runs as app:app (100:101), so keep this value unchanged unless
# the manager image user is changed too.
PUMPKIN_RUNTIME_USER=100:101
# Compose serves HTTP by default, including CasaOS/LAN installs. Keep 1 for
# plain HTTP; set to 0 only when HTTPS is provided by a reverse proxy.
PUMPKIN_INSECURE_COOKIES=1
# Optional comma-separated browser origins when using a reverse proxy.
# PUMPKIN_ALLOWED_ORIGINS=https://panel.example.com
